# ==========================================
# AI RECRUITMENT PORTAL - ENVIRONMENT CONFIG
# ==========================================
DEBUG=True
SECRET_KEY=django-insecure-ai-recruitment-portal-secret-key-123456

# MySQL Database Configuration
DB_NAME=ai_recruitment_db
DB_USER=root
DB_PASSWORD=123456
DB_HOST=127.0.0.1
DB_PORT=3306

# Đặt USE_SQLITE=True nếu bạn muốn chạy thử nghiệm nhanh với SQLite trước khi cấu hình MySQL
USE_SQLITE=False

# ==========================================
# CELERY & REDIS (Xử lý bất đồng bộ)
# ==========================================
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
ENABLE_ASYNC_CELERY=False

# ==========================================
# EMAIL SMTP CONFIGURATION
# ==========================================
# Để test local, giữ EMAIL_BACKEND console (in ra terminal thay vì gửi thật)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Khi production, đổi sang:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Nhập Gmail và App Password (https://myaccount.google.com/apppasswords)
EMAIL_HOST_USER=your_gmail@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=AI Recruitment Portal <noreply@airecruitment.vn>
